# Copie para .env.local.
# Serviço de API (n8n). O navegador só fala com o proxy /api do Next; a URL e o token ficam no servidor.
# Sem N8N_BASE_URL o app roda em MODO DEMONSTRAÇÃO (respostas fixas, nada é calculado nem enviado).
N8N_BASE_URL=
# Opcional: enviado como "Authorization: Bearer <token>" em toda chamada ao n8n.
N8N_TOKEN=

# Supabase: login (Auth) e dados do modo demonstração (faturas confirmadas, casos, cadastro, evidências).
# Sem estas variáveis, o login fica indisponível e os dados ficam em memória.
# Chaves em: painel do Supabase > Project Settings > API Keys (ou `npx supabase projects api-keys --reveal`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor (rota /api). Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=
