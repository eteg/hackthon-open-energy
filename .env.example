# Copie para .env.local. Sem chave, o agente roda em modo offline (RAG da FAQ + templates), custo zero.
ANTHROPIC_API_KEY=
# Modelo do agente (confira preço na aba Orçamento da planilha antes de trocar)
ANTHROPIC_MODEL=claude-haiku-5-5
# Preços para calcular custo por atendimento (US$ por milhão de tokens). Vazio = custo não calculado.
PRECO_INPUT_USD_POR_MTOK=
PRECO_OUTPUT_USD_POR_MTOK=
# Versão das regras em regras/<versao>.yaml
VERSAO_REGRAS=v2026-11
# Opcional: API em outro host (padrão: /api do próprio Next)
NEXT_PUBLIC_API_URL=
