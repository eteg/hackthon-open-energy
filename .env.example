# Copie para .env.local.
# Serviço de API (n8n). O navegador só fala com o proxy /api do Next; a URL e o token ficam no servidor.
# Hoje o n8n atende só a leitura da fatura por arquivo (POST /faturas/extrair, Gemini): essa rota vai para ele quando
# N8N_BASE_URL está definido. O resto (simulação, regras, casos, confirmação) segue em MODO DEMONSTRAÇÃO.
# Sem N8N_BASE_URL, até a leitura da fatura é demonstração (leitura fixa: ignora o conteúdo do arquivo).
# Ex.: https://n8n.brdigital.sbs/webhook   (o caminho do webhook é /faturas/extrair)
N8N_BASE_URL=
# Opcional: enviado como "Authorization: Bearer <token>" ao n8n. Só é preciso se o webhook exigir token.
N8N_TOKEN=

# Supabase: login (Auth) e dados do modo demonstração (faturas confirmadas, casos, cadastro, evidências).
# Sem estas variáveis, o login fica indisponível e os dados ficam em memória.
# Chaves em: painel do Supabase > Project Settings > API Keys (ou `npx supabase projects api-keys --reveal`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor (rota /api). Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=
